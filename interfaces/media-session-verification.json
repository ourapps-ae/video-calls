    {
      "name": "launchOwnedBrowser",
      "description": "Starts the Chromium pinned by Playwright 1.64.1 from the private cache under AEPM_PRIVATE_ROOT, non-detached, headless with fake media devices and a private profile, and connects over the DevTools endpoint. close sends Browser.close, waits for the child and escalates to SIGTERM then SIGKILL within fixed deadlines; profiles remain for the parent's cleanup.",
      "params": [
        {
          "name": "options",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "profileRoot": {
                "type": "string",
                "description": "Absolute, private (mode 0700), beneath AEPM_PRIVATE_ROOT; with a context, its profiles/browser."
              },
              "timeoutMilliseconds": {
                "type": "integer",
                "description": "Defaults to 30000.",
                "minimum": 1,
                "maximum": 60000
              }
            },
            "required": [
              "profileRoot"
            ],
            "additionalProperties": false
          }
        }
      ],
      "result": {
        "name": "owned",
        "schema": {
          "type": "object",
          "required": [
            "browser",
            "close"
          ],
          "properties": {
            "browser": {
              "description": "Playwright Browser."
            },
            "close": {
              "description": "Function () => Promise<void>."
            }
          }
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/HelperError"
        }
      ],
      "tags": [
