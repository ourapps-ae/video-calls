  "components": {
    "schemas": {
      "ExecutionContext": {
        "type": "object",
        "description": "The sanitised execution context aepm writes to AEPM_CONTEXT_FILE (the fields these helpers read).",
        "required": [
          "format",
          "runId",
          "package",
          "id",
          "operations",
          "assertions"
        ],
        "properties": {
          "format": {
            "const": 1
          },
          "runId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "package": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "id": {
            "type": "string"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Authorised operations, for example create-room, delete-created-room, join-room, publish-synthetic-media, subscribe-media, list-account-rooms, create-temporary-simulator, native-build, native-test."
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Assertion ids the result must report."
          },
          "mode": {
            "type": "string",
            "enum": [
              "simulation",
              "live"
            ]
          },
          "simulationKind": {
            "type": "string",
            "enum": [
              "fixture",
              "local-provider"
            ]
          },
          "origins": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Origins the run may reach."
          },
          "settings": {
            "type": "object",
            "properties": {
              "livekitUrl": {
                "type": "string",
                "description": "ws, wss, http or https; live mode needs wss or https, simulation needs a loopback host."
              },
              "ephemeralRoomPrefix": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "maximumSeconds": {
                "type": "integer",
                "minimum": 1
              },
              "applePlatform": {
                "type": "string",
                "enum": [
                  "ios-simulator",
                  "tvos-simulator"
                ]
              },
              "appleDeviceType": {
                "type": "string"
              },
              "appleRuntime": {
                "type": "string"
              }
            }
          },
          "secrets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "version": {}
              },
              "required": [
                "version"
              ],
              "additionalProperties": true
            },
            "description": "Secret name (livekitKey, livekitSecret) to the version aepm resolved; values come from AEPM_SECRETS_FILE."
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "path"
              ],
              "additionalProperties": true
            }
          }
        }
      },
      "Assertion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "actual": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "null for process-tree-terminated and unobserved assertions."
          }
        },
        "required": [
          "id",
          "passed",
          "actual"
        ],
        "additionalProperties": false
      },
      "Resource": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "provider-room",
              "apple-device",
              "android-device"
            ]
          },
          "id": {
            "type": "string"
          },
          "namespace": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "createdByRunId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "created": {
            "type": "boolean"
          },
          "cleaned": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "id",
          "namespace",
          "createdByRunId",
          "created",
          "cleaned"
        ],
        "additionalProperties": false
      },
      "Cleanup": {
        "type": "object",
        "properties": {
          "required": {
            "type": "boolean"
          },
          "attempted": {
            "type": "boolean"
          },
          "completed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "enum": [
              "",
              "cleanup-failed"
            ]
          }
        },
        "required": [
          "required",
