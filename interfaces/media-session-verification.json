    {
      "name": "parse_apple_results",
      "description": "Counts identified ordinary Test Case nodes per target from xcresulttool schema 0.5.0 summary and test tree (nodeIdentifierURL preferred over nodeIdentifier). Each expected target must appear once with non-skipped execution and no failures or expected failures, and the five summary counts must reconcile; unknown outcomes, duplicate identities, nested cases and Arguments, Repetition or Test Case Run layouts fail.",
      "params": [
        {
          "name": "summary",
          "required": true,
          "schema": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        {
          "name": "tests",
          "required": true,
          "schema": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        {
