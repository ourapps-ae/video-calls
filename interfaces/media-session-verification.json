{
  "openrpc": "1.3.2",
  "info": {
    "title": "ae/media-session",
    "version": "1.0.0",
    "description": "Verification helpers for ae/media-session that aepm's runner and package-owned check scripts call under an authorised execution context (installed under components/video-calls/verification; npm ci --prefix components/video-calls --ignore-scripts installs their dependencies). JavaScript modules provider.mjs, adapters.mjs, result.mjs and browser-process.mjs (tagged javascript); Python modules native.py and apple_results.py (tagged python, keyword arguments after context). Results are canonical JSON with no grants, credentials or raw provider output. Simulation with simulationKind fixture uses fixture.mjs, whose frame counts are simulated; a local fixture or local provider does not establish deployed interoperability. Provider service requests need exact paired socket and service origins and configured base paths; redirects fail; account-wide ListRooms needs list-account-rooms; room creation needs a recorded run intent and deletion also checks the recorded identity and the provider's creation metadata.",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    }
  },
  "methods": [
    {
      "name": "verifyMedia",
      "description": "Creates one room named <ephemeralRoomPrefix>-<runId>-0 (recorded before and after creation), joins publisher, subscriber and spectator with production grants, checks the spectator cannot publish, synthetic frames arrive and survive a reconnect, the room is listed (when asserted), display entry stops capture and close stops media, then deletes the room. Observations: publisher-joined, subscriber-joined, subscriber-publish-denied, synthetic-track-received, reconnected, room-listed, board-capture-denied, media-stopped-on-close, room-deleted.",
      "params": [
        {
          "name": "context",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ExecutionContext"
          }
        },
        {
          "name": "dependencies",
          "required": true,
