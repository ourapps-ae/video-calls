    {
      "name": "run_apple",
      "description": "Runs test-without-building on the recorded device only, with literal sorted NAME=value test settings before the fixed signing and action arguments, then reads the result bundle with extract_apple_results and writes the target coverage as an artefact. Observations: build-produced, tests-discovered, tests-executed, tests-passed.",
      "params": [
        {
          "name": "context",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ExecutionContext"
          }
        },
        {
          "name": "project",
          "required": true,
          "schema": {
            "type": "string",
            "description": "Path."
          }
        },
        {
          "name": "scheme",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "derived_data",
          "required": true,
          "schema": {
            "type": "string",
            "description": "Path holding Build/Products."
          }
        },
        {
          "name": "package_cache",
          "required": true,
          "schema": {
            "type": "string",
            "description": "Path."
          }
        },
        {
          "name": "expected_targets",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ExpectedTargets"
          }
        },
        {
          "name": "test_settings",
          "required": false,
          "schema": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "maxLength": 64
            },
            "additionalProperties": {
              "type": "string",
              "description": "HTTP loopback origin with an explicit port and no credentials, query, fragment or path.",
              "pattern": "^http://(localhost|127\\.0\\.0\\.1|\\[::1\\]):[0-9]{1,5}/?$"
            },
            "description": "Names end in _TEST_SERVER_ADDRESS."
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/HelperResult"
        }
      },
      "errors": [
