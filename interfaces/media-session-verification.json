      "tags": [
        {
          "name": "python"
        }
      ],
      "paramStructure": "by-name"
    },
    {
      "name": "extract_apple_results",
      "description": "Queries the result bundle's summary and test tree with xcresulttool (within 30 seconds and 8 MiB; at most 100000 nodes, depth 64) and returns parse_apple_results of them.",
      "params": [
        {
          "name": "bundle",
          "required": true,
          "schema": {
            "type": "string",
            "description": "Path of the .xcresult bundle."
          }
        },
        {
          "name": "expected_targets",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ExpectedTargets"
          }
        },
        {
          "name": "env",
          "required": true,
          "schema": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        {
          "name": "deadline",
          "required": true,
          "schema": {
            "type": "number",
            "description": "time.monotonic() deadline."
          }
        },
        {
          "name": "query",
          "required": false,
          "schema": {
            "description": "Function replaces the xcresulttool call."
          }
        },
        {
          "name": "clock",
          "required": false,
          "schema": {
            "description": "Function replaces time.monotonic."
          }
        }
      ],
      "result": {
