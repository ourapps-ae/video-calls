  "components": {
    "schemas": {
      "VideoEnv": {
        "type": "object",
        "description": "Server environment; other keys are ignored.",
        "properties": {
          "LIVEKIT_URL": {
            "type": "string"
          },
          "LIVEKIT_API_KEY": {
            "type": "string"
          },
          "LIVEKIT_API_SECRET": {
            "type": "string"
          }
        }
      },
      "VideoSettings": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Defaults to true."
          },
          "serviceUrl": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "VideoSecrets": {
        "type": "object",
        "properties": {
          "apiKey": {
            "type": "string"
          },
          "apiSecret": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "VideoGrant": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "wss or ws address of the service."
          },
          "token": {
            "type": "string",
            "description": "HS256 JWT valid six hours."
          },
          "room": {
            "type": "string",
            "description": "roomPrefix + tableId."
