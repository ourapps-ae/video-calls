          "schema": {
            "type": "string"
          }
        },
        {
          "name": "now",
          "required": true,
          "schema": {
            "type": "number",
            "description": "Milliseconds since the epoch."
          }
        },
        {
          "name": "publish",
          "required": true,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "roomPrefix",
          "required": true,
